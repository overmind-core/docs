      "og:image": "https://docs.overmindlab.ai/images/og-default.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.overmindlab.ai/images/og-default.png"
    }
  },
  "colors": {
    "primary": "#ed670f",
    "light": "#f69a5b",
    "dark": "#ed670f"
  },
  "background": {
    "color": {
      "light": "#f6f5f1",
      "dark": "#16120f"
    }
  },
  "fonts": {
