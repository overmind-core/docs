{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Overmind",
  "theme": "luma",
  "logo": {
    "light": "/logo/overmind-eye-copper.svg",
    "dark": "/logo/overmind-eye-copper.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#ed670f",
    "light": "#f69a5b",
    "dark": "#ed670f"
  },
  "background": {
    "color": {
      "light": "#f6f5f1",
      "dark": "#16120f"
    }
  },
  "fonts": {
    "heading": {
      "family": "PP Mondwest",
      "source": "/fonts/PPMondwest-Regular.woff2",
      "format": "woff2",
      "weight": 400
    },
    "body": {
      "family": "Geist",
      "source": "/fonts/Geist-Regular.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.overmindlab.ai"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Tracing",
        "pages": [
          "core/observability",
          "tracing/sdk-python",
          "tracing/sdk-typescript"
        ]
      },
      {
        "group": "Core",
        "pages": [
          "core/capabilities",
          "core/datasets"
        ]
      },
      {
        "group": "Agent Testing",
        "pages": [
          "agent-testing/eval",
          "agent-testing/trace-scoring",
          "agent-testing/optimisers"
        ]
      },
      {
        "group": "Models",
        "pages": [
          "models/training",
          "models/inference"
        ]
      },
      {
        "group": "Platform",
        "pages": [
          "platform/api",
          "platform/administration",
          "platform/glossary"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/context/agents",
      "destination": "/core/capabilities"
    },
    {
      "source": "/context/repositories",
      "destination": "/core/capabilities"
    },
    {
      "source": "/context/datasets-and-traces",
      "destination": "/core/datasets"
    },
    {
      "source": "/onboarding/onboarding",
      "destination": "/"
    },
    {
      "source": "/onboarding/tracing",
      "destination": "/core/observability"
    },
    {
      "source": "/onboarding/instrumentation",
      "destination": "/core/observability"
    },
    {
      "source": "/onboarding/integrations",
      "destination": "/core/observability"
    },
    {
      "source": "/evaluation/eval-metrics",
      "destination": "/agent-testing/eval"
    },
    {
      "source": "/evaluation/optimizers",
      "destination": "/agent-testing/optimisers"
    },
    {
      "source": "/agent-testing/optimizers",
      "destination": "/agent-testing/optimisers"
    },
    {
      "source": "/fine-tuning",
      "destination": "/models/training"
    },
    {
      "source": "/inference",
      "destination": "/models/inference"
    },
    {
      "source": "/core/agents",
      "destination": "/core/capabilities"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  }
}
