      "family": "PP Mondwest",
      "source": "/fonts/PPMondwest-Regular.woff2",
      "format": "woff2",
      "weight": 400
    },
    "body": {
      "family": "Geist Pixel",
      "source": "/fonts/GeistPixel-Square.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "styling": {
